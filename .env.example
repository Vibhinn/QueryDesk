# Gemini is the default provider. Add your Google AI API key before starting the API.
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-3.8-flash
GOOGLE_API_KEY=

# Optional keys/config for other providers.
MODEL_API_KEY=
MODEL_BASE_URL=

# Used when running the backend directly on your host. docker-compose overrides this for its API container.
DATABASE_URL=postgresql+psycopg://nl2sql:nl2sql@localhost:5432/nl2sql_demo
SCHEMA_PATH=SCHEMA.md
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_MS=8000

# Local development only: replace these before exposing the services beyond localhost.
APP_DB_PASSWORD=querydesk-dev-only
